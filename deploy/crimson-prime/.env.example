# Copy to a VPS-only .env (mode 0600). Placeholders only — never commit real
# hostnames, passwords, VPS addresses, or public IPs.

EMR_WEBMCP_BIND_ADDRESS=127.0.0.1
EMR_WEBMCP_PORT=18080

OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Public hostname and synthetic-data acknowledgement are required at deploy
# time. Placeholders only — never a real hostname or a real-PHI attestation.
OPENMRS_PUBLIC_HOSTNAME=example.invalid
SYNTHETIC_DATA_ACK=change-me
OPENMRS_USERNAME=change-me
OPENMRS_PASSWORD=change-me

# Optional. Frontend image assemble uses this openmrs CLI/app-shell tag.
APP_SHELL_VERSION=next
