{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@playwright/test"]
  },
  "include": [
